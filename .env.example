SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cohost_marketplace

# Cache — required for atomic rate limiting; swap locmem for Redis in prod
CACHE_URL=redis://localhost:6379/1

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Monitoring
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Behind a reverse proxy (Caddy/nginx) set BEHIND_PROXY=True and CSRF_TRUSTED_ORIGINS=https://yourdomain.com
BEHIND_PROXY=False
CSRF_TRUSTED_ORIGINS=

# Any secret above can instead be read from a file: SECRET_KEY_FILE=/run/secrets/secret_key
# (supported: SECRET_KEY, DATABASE_URL, CACHE_URL, EMAIL_HOST_PASSWORD, SENTRY_DSN)

# Production security (enable when behind HTTPS)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
